# Copy to .env. Everything here stays on this machine.
DATABASE_PATH=./data/finance.db
NEXT_TELEMETRY_DISABLED=1
# Required only when SMS ingestion is enabled. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SMS_ENCRYPTION_KEY=
# The tailnet HTTPS address phones use to reach Hisaab, for the pairing QR code.
# Example: https://hisaab-pc.tailnet-name.ts.net
SMS_PAIRING_URL=
